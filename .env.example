# Database
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=trading_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-fernet-key-here-change-in-production  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# API Keys
ALPHA_VANTAGE_API_KEY=demo
NEWS_API_KEY=your_newsapi_key
FRED_API_KEY=your_fred_key

# Portfolio advisor narrative generation (requires AWS Bedrock access)
PORTFOLIO_ADVISOR_LLM_ENABLED=false
PORTFOLIO_ADVISOR_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
PORTFOLIO_ADVISOR_BEDROCK_REGION=us-east-1
PORTFOLIO_ADVISOR_RESEARCH_ENABLED=false
RESEARCHER_AGENT_URL=http://researcher-agent:8000
RESEARCHER_API_KEY=<generate-a-private-service-key>
RESEARCHER_RUN_TIMEOUT=600
RESEARCHER_MAX_CONCURRENCY=2

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Planner ---
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_REGION=us-west-2
MOCK_LAMBDAS=false

# Specialist Lambda names
TAGGER_FUNCTION=trading-tagger
REPORTER_FUNCTION=trading-reporter
CHARTER_FUNCTION=trading-charter
RETIREMENT_FUNCTION=trading-retirement

# Event bus
EVENT_BUS_NAME=trading-platform-events

# SQS queues
SQS_QUEUE_NAME=trading-analysis-jobs

# Market
POLYGON_API_KEY=<from-secrets-manager>
POLYGON_PLAN=free
ALLOW_RANDOM_PRICES=false
DEFAULT_MISSING_PRICE=0

# Observability
LANGFUSE_SECRET_KEY=<from-secrets-manager>
LANGFUSE_PUBLIC_KEY=<from-secrets-manager>
LANGFUSE_FLUSH_WAIT_SECONDS=2

# --- Report Writer ---
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_REGION=us-west-2
REPORTER_MIN_SCORE=0.3

# Event bus
EVENT_BUS_NAME=trading-platform-events

# Knowledge base
VECTOR_BUCKET=trading-platform-vectors
INDEX_NAME=financial-research
SAGEMAKER_ENDPOINT=trading-platform-embedding-endpoint

# Observability
LANGFUSE_SECRET_KEY=<from-secrets-manager>
LANGFUSE_PUBLIC_KEY=<from-secrets-manager>
LANGFUSE_FLUSH_WAIT_SECONDS=2


# --- Retirement Specialist ---
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_REGION=us-west-2
RETIREMENT_SIMULATIONS=1000
RETIREMENT_YEARS=30
RETIREMENT_INFLATION=0.03
RETIREMENT_CONTRIBUTION=10000
RETIREMENT_CURRENT_AGE=40
EVENT_BUS_NAME=trading-platform-events

# --- API Gateway ---
CORS_ORIGINS=http://localhost:3000,https://app.tradingplatform.com
CLERK_JWKS_URL=https://<your-tenant>.clerk.accounts.dev/.well-known/jwks.json
SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<acct>/trading-analysis-jobs
DEFAULT_AWS_REGION=us-east-1