# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
trading_platform.db

# Node
node_modules/
dist/
build/
frontend/.vite/
frontend/dist/
frontend/node_modules/
frontend/release-evidence/*.json
.vite-cache/

# Environments and secrets
.env
frontend/.env
*.local
!.env.example
!frontend/.env.example
config/*.secret.env

# Runtime and local browser artifacts
*.log
*.err.log
*-local.json
.edge-profile/
*.pma
*.tsbuildinfo

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Lambda build artifacts (written in each source folder by
# .github/scripts/ci/build_one_lambda.sh and the per-service packagers)
backend/**/*_lambda.zip
backend/**/lambda_function.zip

# Terraform environment roots: the real tfvars hold secrets and are written only by CI
infrastructure/terraform/envs/*/terraform.auto.tfvars.json
infrastructure/terraform/envs/*/.terraform/
infrastructure/terraform/envs/*/plan.tfplan
